{
  "name": "imoti-powered-mcp",
  "version": "0.2.0",
  "description": "A conversational assistant for Bulgarian property listings",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/simon-office/imoti-powered-mcp.git" },
  "homepage": "https://github.com/simon-office/imoti-powered-mcp#readme",
  "bugs": { "url": "https://github.com/simon-office/imoti-powered-mcp/issues" },
  "keywords": ["imot.bg", "real-estate", "property-search", "mcp", "claude-code"],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test",
    "package:release": "npm run build && node scripts/package-release.mjs",
    "search": "node --disable-warning=ExperimentalWarning dist/cli.js search",
    "listing": "node --disable-warning=ExperimentalWarning dist/cli.js listing",
    "refresh": "node --disable-warning=ExperimentalWarning dist/cli.js refresh"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "node-html-parser": "^9.0.4",
    "playwright-core": "^1.56.1",
    "zod": "^4.6.5"
  }
}
